# Copy to .env.local (git-ignored) and fill in your Supabase development project values.
# Both values are public client values (Project Settings -> API Keys). Never put the secret/service-role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Leave empty in development: the Vite dev server proxies /api to the local API (http://localhost:5080).
VITE_API_BASE_URL=
