<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>92679a02-0fff-4e6c-9a8a-27361f7b5e4f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated from the TypeScript model (packages/architecture); one source of truth for both validators. -->
    <EmbeddedResource Include="..\..\..\schemas\architecture.schema.json" LogicalName="architecture.schema.json" Link="architecture.schema.json" />
    <EmbeddedResource Include="..\..\..\schemas\challenge.schema.json" LogicalName="challenge.schema.json" Link="challenge.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Challenge content (ADR-008) ships with the API, which validates it at startup. Reference solutions are
         test material for the content check, so they are left out. -->
    <Content Include="..\..\..\content\challenges\**\*" Exclude="..\..\..\content\challenges\**\solutions\**" LinkBase="content\challenges" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SystemDesignLab.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
