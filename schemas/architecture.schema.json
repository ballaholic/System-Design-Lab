                  "ingestCapacity": {
                    "default": 100000,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000000
                  },
                  "partitions": {
                    "default": 8,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1024
                  }
                }
              }
            },
            "required": [
              "id",
              "type",
              "label",
              "config"
            ]
          }
        ]
      }
    },
    "edges": {
      "maxItems": 400,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "label": {
            "type": "string",
            "maxLength": 60
          }
        },
        "required": [
          "id",
          "source",
          "target"
        ]
      }
    },
    "layout": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "y": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          }
        },
        "required": [
          "x",
          "y"
        ]
      }
    },
    "edgeLayout": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "top",
              "right",
              "bottom",
              "left"
            ]
          },
          "target": {
            "type": "string",
            "enum": [
              "top",
              "right",
              "bottom",
              "left"
            ]
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 4096
    },
    "traffic": {
      "type": "object",
      "properties": {
        "totalRps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "mix": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "required": [
        "totalRps"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "operations",
    "nodes",
    "edges",
    "layout"
  ]
}
